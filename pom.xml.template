<!-- 
  Sample POM configuration for deploying to DPC Maven Repository.
  Add the sections below to your project's pom.xml as needed.

  The <distributionManagement> URLs are overridden at CI build time via
  the -DaltDeploymentRepository flag in the reusable-publish workflow, so
  local builds without NEXUS_URL set will fall back to these defaults.
-->

<!-- ================================================================== -->
<!-- Distribution management (required for mvn deploy)                  -->
<!-- ================================================================== -->
<distributionManagement>
  <repository>
    <id>dpc-maven-repo</id>
    <name>DPC Maven Repository - Releases</name>
    <url>${env.NEXUS_URL}/repository/maven-releases/</url>
  </repository>
  <snapshotRepository>
    <id>dpc-maven-repo</id>
    <name>DPC Maven Repository - Snapshots</name>
    <url>${env.NEXUS_URL}/repository/maven-snapshots/</url>
  </snapshotRepository>
</distributionManagement>

<!-- ================================================================== -->
<!-- Optional: consume artifacts from the DPC Maven Repository          -->
<!-- ================================================================== -->
<repositories>
  <repository>
    <id>dpc-maven-repo-releases</id>
    <url>${env.NEXUS_URL}/repository/maven-releases/</url>
    <releases>
      <enabled>true</enabled>
    </releases>
    <snapshots>
      <enabled>false</enabled>
    </snapshots>
  </repository>
  <repository>
    <id>dpc-maven-repo-snapshots</id>
    <url>${env.NEXUS_URL}/repository/maven-snapshots/</url>
    <releases>
      <enabled>false</enabled>
    </releases>
    <snapshots>
      <enabled>true</enabled>
    </snapshots>
  </repository>
</repositories>
