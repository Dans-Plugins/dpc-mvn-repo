# Environment variables for DPC Maven Repository
# Copy this file to .env and customize as needed.
#
# Docker Compose reads .env from this directory and substitutes each value
# into docker-compose.yml. Every value below is also the default that applies
# when .env is absent, so an unmodified copy changes nothing.
#
# Only the variables listed here have an effect. The container name and the
# nexus-data volume are referenced by their literal names in setup.sh,
# backup.sh, restore.sh, and the Makefile, so they are deliberately not
# configurable. To bind Nexus to a specific interface or to use a host
# directory instead of a Docker volume, use docker-compose.override.yml
# (see docker-compose.override.yml.example).

# Nexus Configuration
# Port to expose Nexus on the host
NEXUS_PORT=8081

# JVM Memory Settings (adjust based on your needs)
# Minimum heap size
NEXUS_MIN_HEAP=512m
# Maximum heap size
NEXUS_MAX_HEAP=512m
# Maximum direct memory
NEXUS_MAX_DIRECT_MEMORY=273m
