# Environment variables for DPC Maven Repository
# Copy this file to .env and customize as needed

# Nexus Configuration
# Port to expose Nexus on the host
NEXUS_PORT=8081

# JVM Memory Settings (adjust based on your needs)
# Minimum heap size
NEXUS_MIN_HEAP=512m
# Maximum heap size
NEXUS_MAX_HEAP=512m
# Maximum direct memory
NEXUS_MAX_DIRECT_MEMORY=273m

# Container Configuration
CONTAINER_NAME=dpc-maven-repo

# Volume Configuration
NEXUS_DATA_VOLUME=nexus-data

# Optional: Customize host binding (uncomment to use)
# NEXUS_HOST=127.0.0.1

# Optional: Custom volume path (uncomment to use host directory instead of Docker volume)
# NEXUS_DATA_PATH=/path/to/nexus-data
